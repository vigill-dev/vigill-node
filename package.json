{
  "name": "@vigill/node",
  "version": "0.1.0",
  "description": "Plain-English production error monitoring for Node.js servers — the Vigil Node SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --test-timeout=15000 --experimental-strip-types test/node-sdk.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "error-monitoring",
    "error-tracking",
    "observability",
    "nodejs",
    "vigil"
  ],
  "author": "Rajeev Chourey",
  "license": "MIT",
  "homepage": "https://vigill.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigill-dev/vigil-node.git"
  },
  "bugs": {
    "url": "https://github.com/vigill-dev/vigil-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
